{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.motoapppreview.g1z2up",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Describe bike symptoms by voice for hands-free help",
        "NSCameraUsageDescription": "Snap a photo of your bike for your profile",
        "NSPhotoLibraryUsageDescription": "Choose a bike photo for your profile",
        "NSLocationWhenInUseUsageDescription": "Share your breakdown location with rescue contacts"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.motoapppreview.g1z2up",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-audio",
        { "microphonePermission": "Describe bike symptoms by voice for hands-free help" }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a bike photo for your profile",
          "cameraPermission": "Snap a photo of your bike for your profile"
        }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Share your breakdown location with rescue contacts" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
